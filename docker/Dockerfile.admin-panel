# Imagem do painel admin (Fase 2 do lembrete de renovação do Clube, /admin/*),
# export estático do apps/pdv-frontend servido por um static server simples
# — não precisa de runtime Next.js nenhum (output: 'export'). COPY seletivo
# em vez da raiz inteira, mesmo motivo do Dockerfile.intermediador.
FROM node:22-alpine AS base
WORKDIR /repo

FROM base AS deps
RUN corepack enable
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* turbo.json ./
COPY packages ./packages
COPY apps/pdv-frontend ./apps/pdv-frontend
RUN pnpm install --frozen-lockfile --filter @easypdv/pdv-frontend...

FROM deps AS build
# BUILD_TARGET=admin-web troca assetPrefix pra caminho absoluto — sem isso,
# qualquer rota fora da raiz (/admin/login, /admin/clube, ...) 404 em tudo
# (achado real, ver docs/CHANGELOG.md "Fase 2 do lembrete de renovação do
# Clube"). NEXT_PUBLIC_INTERMEDIADOR_URL precisa existir em BUILD TIME (Next
# inlina NEXT_PUBLIC_* no bundle na hora do build, não em runtime) — o
# Railway repassa as variáveis do serviço como build args automaticamente
# pro builder Docker.
ARG NEXT_PUBLIC_INTERMEDIADOR_URL
ENV BUILD_TARGET=admin-web
ENV NEXT_PUBLIC_INTERMEDIADOR_URL=${NEXT_PUBLIC_INTERMEDIADOR_URL}
RUN pnpm exec turbo run build --filter=@easypdv/pdv-frontend

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /repo/apps/pdv-frontend/out ./out
RUN npm install -g serve
# $PORT vem do Railway em runtime, nunca fixo — forma shell do CMD pra
# expandir a variável (forma exec não faz substituição de shell).
CMD ["sh", "-c", "serve -s out -l ${PORT:-3000}"]
