# Portas 5433/6380 (não 5432/6379) porque é o que docker/docker-compose.yml
# publica por padrão — ver o comentário lá sobre conflito com as portas padrão.
# Se você sobrescrever POSTGRES_PORT/REDIS_PORT no compose, ajuste aqui também.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/easypdv_intermediador"
REDIS_URL="redis://localhost:6380"
PORT=4002
NODE_ENV=development

# --- Bling OAuth — OBRIGATÓRIAS ---
# BlingOAuthClient usa getOrThrow. Cuidado com a pegadinha: getOrThrow só
# dispara quando a chave está AUSENTE (undefined) — deixá-la aqui vazia passa
# na checagem e o app sobe normal, mas aí qualquer chamada OAuth falha depois,
# com erro bem menos óbvio. Ou seja: preencha de verdade.
# Se a chave sumir do .env, o boot falha na hora com
# "Configuration key "BLING_CLIENT_ID" does not exist" — esse é o caso fácil.
# Crie o app em https://developer.bling.com.br (Meus Aplicativos) e cadastre lá
# o mesmo redirect abaixo — ele precisa bater exatamente, é validado no
# authorize E no exchange do code.
# Em produção, nunca em texto puro: usar o cofre de segredo do Railway.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI="http://localhost:4002/integrations/bling/callback"

# --- Bling — opcionais ---
# Trava de segurança da emissão automática de NFC-e. Só "true" liga; qualquer
# outro valor (ou ausente) mantém desligado.
BLING_NFCE_AUTO_EMIT=false

# Forma de pagamento usada ao criar o pedido no Bling. O Bling não tem endpoint
# de listagem de formas de pagamento, então o id precisa ser descoberto na conta
# e configurado aqui — ver BlingSyncTargetAdapter.
# BLING_DEFAULT_PAYMENT_METHOD_ID=

# Mapa opcional JSON por método de pagamento; o id fixo acima é o fallback.
# JSON inválido é ignorado com warning (não quebra o boot).
# BLING_PAYMENT_METHOD_ID_MAP={}

# --- Sessão de admin (OrgAuthSession) — OBRIGATÓRIAS ---
# Login direto no Intermediador (painel administrativo, Fase 0 — distinto do
# verify-login mediado por terminal, que não emite sessão). Mesma pegadinha
# do getOrThrow do BLING_CLIENT_ID acima: vazia passa no boot, quebra só na
# primeira tentativa de login.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Em produção, usar o cofre de segredo do Railway — NUNCA reaproveitar o
# JWT_SECRET do pdv-backend (apps diferentes, segredos independentes).
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
