// Intermediador — hospedado no Railway, banco PostgreSQL.
// Único lugar que fala com o Bling. Schema inicial do Sprint 0: só o suficiente
// para uma organização/loja se registrar — ver Claude/Projetos/EasyPDV/Modelo de Domínio.md no cofre Obsidian.

// output custom: pdv-backend e intermediador dependem da mesma versão de
// @prisma/client, que o pnpm deduplica para uma única pasta física no store —
// sem isso, `prisma generate` de um app sobrescreve o client gerado do outro
// (schemas diferentes, mesmo destino). Ver docs/BACKEND.md.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  document  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  stores    Store[]

  erpIntegrations  ErpIntegration[]
  erpSyncMappings  ErpSyncMapping[]
  fiscalDocuments  FiscalDocument[]
  orgUsers         OrgUser[]
  clubMemberships  ClubMembership[]

  storeCreditBalances    StoreCreditBalance[]
  storeCreditGrants      StoreCreditGrant[]
  storeCreditRedemptions StoreCreditRedemption[]
  customers              Customer[]
}

// Mesmos valores de UserRole em apps/pdv-backend/prisma/schema.prisma (enum
// próprio aqui — schemas/bancos diferentes, sem tipo compartilhado possível
// entre SQLite e Postgres — mas os NOMES precisam ficar em sincronia, porque
// o role trafega entre os dois via OrgUserPayload/verify-login, ver
// packages/shared-validation `userRoleSchema`).
enum UserRole {
  operador
  supervisor
  gerente
  administrador
  proprietario
  auditor
  tecnico
}

// Login único entre terminais (2026-08-21) — usuário CANÔNICO por
// organização. Cada terminal (SQLite, User local) continua tendo seu próprio
// espelho/cache, casado por e-mail; este model aqui é a fonte da verdade da
// senha. `@@unique([organizationId, email])` (não email global): duas
// organizações diferentes podem ter administradores com o mesmo e-mail sem
// conflito, cada uma é um cliente EasyPDV independente. `employeeCode`
// sequencial por organização (mesmo padrão do User local, matrícula exibida
// em telas/relatórios, não é mecanismo de login).
model OrgUser {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  passwordHash   String
  role           UserRole
  active         Boolean      @default(true)
  employeeCode   Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  authSessions OrgAuthSession[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// Sessão de login direto no Intermediador (Fase 0 do painel administrativo,
// 2026-09-10) — distinta do login mediado por terminal (`verify-login`, que
// não emite sessão nenhuma, só confirma credencial pro pdv-backend). Mesmo
// padrão de refresh token do AuthSession (pdv-backend/SQLite): opaco
// (`sessionId.secret`), hash guardado (nunca o secret em claro), rotacionado
// a cada uso (RefreshTokenUseCase revoga a sessão antiga e cria uma nova).
model OrgAuthSession {
  id               String    @id @default(cuid())
  orgUserId        String
  orgUser          OrgUser   @relation(fields: [orgUserId], references: [id])
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([orgUserId])
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  document       String?
  timezone       String       @default("America/Sao_Paulo")
  createdAt      DateTime     @default(now())

  activationCodes ActivationCode[]
  terminals       Terminal[]
}

// Provisionamento de terminal (Sprint 10). Um Administrador gera um código
// (via POST /organizations/:id/activation-codes) e informa ao operador do PC
// novo; o Electron troca esse código por uma identidade de Terminal
// permanente em POST /terminals/activate. Curto prazo de validade — não é
// pra ser reutilizado nem persistir além da ativação em si.
model ActivationCode {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Representa um PC/instalação do Electron ativada contra uma Store. apiKeyHash
// é SHA-256 (determinístico, não bcrypt) porque a apiKey já nasce
// alta-entropia/aleatória — o problema aqui é lookup rápido por índice único,
// não resistência a força bruta sobre senha de baixa entropia (esse é o caso
// de uso do bcrypt, usado em User.passwordHash). O valor em texto puro só
// existe uma vez, na resposta de POST /terminals/activate — nunca persistido
// aqui, só localmente no StoreIdentity (SQLite) do PDV local que o recebeu.
model Terminal {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String    @default("Terminal")
  apiKeyHash  String    @unique
  activatedAt DateTime  @default(now())
  lastSeenAt  DateTime?
}

// Só "bling" tem Adapter implementado na V1 — os demais valores existem pra
// bater com packages/shared-types (ErpProvider) e não exigir migration
// quando um segundo ERP for suportado de verdade. Ver docs/ROADMAP.md.
enum ErpProvider {
  bling
  tiny
  omie
  conta_azul
  proprio
}

// Credenciais OAuth por organização (Sprint 7). refresh_token do Bling roda
// a cada uso — accessToken/refreshToken/expiresAt são sempre sobrescritos
// juntos no BlingOAuthClient, nunca atualizados parcialmente.
model ErpIntegration {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       ErpProvider @default(bling)
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  connectedAt    DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([organizationId, provider])
}

// Cache de resolução de IDs externos — evita resolver produto/contato/forma
// de pagamento no Bling a cada sincronização. localEntityType: "product"
// (SKU → id do produto no Bling) | "sale" (Sale.id local → id do pedido de
// venda criado no Bling). Fica fora dos agregados de domínio de propósito —
// é o que impede o Bling de contaminar a arquitetura (ver docs/ARCHITECTURE.md).
model ErpSyncMapping {
  id              String      @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  provider        ErpProvider @default(bling)
  localEntityType String
  localEntityId   String
  externalId      String
  createdAt       DateTime    @default(now())

  @@unique([organizationId, provider, localEntityType, localEntityId])
  @@index([organizationId, provider, localEntityType])
}

// Mesmos enums de packages/shared-types/src/enums.ts (FiscalDocumentType/
// FiscalDocumentStatus) — já pré-desenhados desde o Sprint 0, reaproveitados
// aqui em vez de inventar valores novos. `status` é simplificado a partir da
// `situacao` numérica que o Bling devolve pra NFC-e (1 Pendente, 2 Cancelada,
// 3 Aguardando recibo, 4 Rejeitada, 5 Autorizada, 6 Emitida DANFE,
// 7 Registrada, 8 Aguardando protocolo, 9 Denegada, 10 Consulta situação,
// 11 Bloqueada — ver bling-erp-api-js `ISituacaoNfce`): 1/3/7/8/10→pending,
// 5/6→issued, 2→cancelled, 4/9/11→error (junto com falha da nossa própria
// chamada — rede, Bling fora do ar — que nunca chega a um veredito da SEFAZ).
// `externalStatus` guarda o código bruto do Bling, pra não perder informação.
enum FiscalDocumentType {
  nfce
  comprovante_nao_fiscal
}

enum FiscalDocumentStatus {
  pending
  issued
  cancelled
  error
}

// Rastreia a NFC-e emitida no Bling a partir do pedido de venda já criado
// (ErpSyncMapping localEntityType="sale"). Emissão é opt-in via
// BLING_NFCE_AUTO_EMIT (default desligado) — ver BlingSyncTargetAdapter e
// Claude/Projetos/EasyPDV/Decisões e Riscos Abertos.md no cofre Obsidian:
// emitir NFC-e é uma ação fiscal real (SEFAZ), não reversível como um
// "pedido de venda" de teste, então não roda automaticamente sem a
// organização ter configurado NFC-e de verdade no Bling. O PDV local consulta
// esta tabela sob demanda (GET, ver FiscalController) e espelha o resultado
// simplificado num FiscalDocument próprio (SQLite) — ver docs/DATABASE.md.
model FiscalDocument {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  provider       ErpProvider          @default(bling)
  saleId         String
  type           FiscalDocumentType   @default(nfce)
  status         FiscalDocumentStatus @default(pending)
  externalId     String
  externalStatus Int?
  documentNumber String?
  accessKey      String?
  danfeUrl       String?
  // Sprint 14 — extraído de <infNFeSupl><qrCode> no XML autorizado devolvido
  // pelo Bling (BlingApiClient.findNfce), nunca reconstruído a partir de
  // UF+chave. Ver docs/DATABASE.md.
  qrCodeUrl      String?
  errorMessage   String?
  // Investigação 02/09 (NFC-e rejeitada 704 "Data-Hora de emissão atrasada"):
  // 3 rejeições reais numa janela de ~3h30, sem causa determinística achada
  // no payload (dataSaida/data não correlacionavam com quem falhava) —
  // padrão condizente com instabilidade pontual da SEFAZ/Bling. Como o
  // status "error" nunca reconsultava sozinho, a nota ficava travada pra
  // sempre. `retryCount` limita as tentativas automáticas do
  // FiscalRetryWorker (MAX_AUTO_RETRY_ATTEMPTS) — o botão manual no
  // Histórico ignora esse teto.
  retryCount     Int                  @default(0)
  issuedAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, provider, saleId])
  @@index([saleId])
}

// Cache local de validade do Clube Saldão — a lista de membros em si sempre
// vem ao vivo do Bling (contato com o tipo de contato "Clube Saldão", fonte
// da verdade), essa tabela só existe pra checar elegibilidade rápido na hora
// da venda sem depender do Bling (rate limit 3 req/s) nem guardar a validade
// lá (Bling não tem campo nativo pra isso). Ver Planejamento - Clube Saldão.md
// no cofre Obsidian.
model ClubMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       ErpProvider  @default(bling)
  customerCpf    String
  validUntil     DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider, customerCpf])
  @@index([organizationId, validUntil])
}

// Vale-Troca (2026-09-10) — crédito de troca vinculado a CPF, resgatável em
// qualquer terminal da organização (saldo GERAL, não por loja — pedido
// explícito do usuário: "o sistema inteiro foi criado para apenas uma
// empresa... então o saldo é geral"). Mesmo desenho do ClubMembership
// (central no Intermediador, terminal consulta via apiKey), mas aqui com
// projeção + ledger (como StockItem/StockMovement no pdv-backend) em vez de
// só um valor upsertado: StoreCreditBalance é a projeção atual (decremento
// atômico via `UPDATE ... WHERE balance >= amount`, nunca fica negativo,
// mesma técnica do débito de estoque — ver docs/ERROR-HANDLING.md),
// StoreCreditGrant/StoreCreditRedemption são o ledger de auditoria. Ver
// Planejamento - Vale-Troca (Crédito por CPF).md no cofre Obsidian.
model StoreCreditBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerCpf    String
  balance        Float        @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, customerCpf])
  @@index([organizationId])
}

// Cabeçalho de uma troca (geração de crédito) — itemizado, pra auditoria e
// pro pdv-backend saber quais itens devolver ao estoque local (só os
// marcados `restock: true` em StoreCreditGrantItem). customerName/Phone são
// um snapshot pro admin conseguir identificar o CPF sem cruzar com o SQLite
// de um terminal específico — o cadastro de verdade (Customer) é local.
model StoreCreditGrant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerCpf    String
  customerName   String?
  customerPhone  String?
  storeId        String?
  terminalId     String?
  totalAmount    Float
  createdAt      DateTime     @default(now())

  items StoreCreditGrantItem[]

  @@index([organizationId, customerCpf])
}

// Sem FK pro catálogo — o Intermediador não tem Product próprio (catálogo
// vive no SQLite de cada terminal, vindo do Bling), então sku/nome são
// snapshot em texto no momento da troca, não referência viva.
model StoreCreditGrantItem {
  id             String           @id @default(cuid())
  grantId        String
  grant          StoreCreditGrant @relation(fields: [grantId], references: [id])
  productSku     String
  productName    String
  quantity       Float
  unitPrice      Float
  discountAmount Float            @default(0)
  totalAmount    Float
  restock        Boolean          @default(true)

  @@index([grantId])
}

// Resgate — sem itens (não é uma troca nova, é débito de um valor contra o
// saldo, dentro de uma venda normal). `saleReference` é o id da Sale local
// (SQLite do terminal) só pra auditoria cruzada manual — sem FK de verdade,
// bancos diferentes.
model StoreCreditRedemption {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  customerCpf    String
  amount         Float
  storeId        String?
  terminalId     String?
  saleReference  String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, customerCpf])
}

// Cliente centralizado (2026-09-11) — até aqui `Customer` era só uma tabela
// local por terminal no pdv-backend (SQLite), sem relação nenhuma com outros
// terminais nem com o Bling. Pedido direto do usuário: "eu não gosto de nada
// local, leva tudo para o intermediador e deixa o pdv buscar lá. todos os
// terminais precisam ser comunicaveis" — mesmo padrão já usado pra
// ClubMembership e StoreCreditBalance, agora pro cadastro de cliente em si.
// De propósito SEM relação com os contatos do Bling (`resolveContactByCpf`
// em bling-sync-target.adapter.ts) — são dois cadastros paralelos, sem
// tentativa de fundir os dois aqui.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  document       String?
  phone          String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, document])
  @@index([organizationId, name])
}

enum SyncStatus {
  pending
  processing
  synced
  failed
}

// Recebido via POST /sync (chamado pelo SyncOutboxWorker do PDV local).
// Enfileirado no BullMQ (fila "sync") para processamento assíncrono.
// `@@unique([entityType, entityId])` garante idempotência: reenvio do mesmo
// entityId (ex: timeout ambíguo do lado do PDV local) não duplica o job.
// Sem Adapter real ainda (ver Sprint 7 — Adapter Bling): o processor desta
// Sprint 6 usa um NoopSyncTargetAdapter só para provar a fila ponta a ponta.
// storeId é opcional porque o provisionamento de terminal (Sprint 10) e a
// autenticação PDV local ↔ Intermediador ainda não existem — ver
// Claude/Projetos/EasyPDV/Decisões e Riscos Abertos.md no cofre Obsidian.
model SyncJob {
  id         String     @id @default(cuid())
  storeId    String?
  entityType String
  entityId   String
  payload    Json
  status     SyncStatus @default(pending)
  attempts   Int        @default(0)
  lastError  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
}
