// Intermediador — hospedado no Railway, banco PostgreSQL.
// Único lugar que fala com o Bling. Schema inicial do Sprint 0: só o suficiente
// para uma organização/loja se registrar — ver Claude/Projetos/EasyPDV/Modelo de Domínio.md no cofre Obsidian.

// output custom: pdv-backend e intermediador dependem da mesma versão de
// @prisma/client, que o pnpm deduplica para uma única pasta física no store —
// sem isso, `prisma generate` de um app sobrescreve o client gerado do outro
// (schemas diferentes, mesmo destino). Ver docs/BACKEND.md.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  document  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  stores    Store[]

  erpIntegrations  ErpIntegration[]
  erpSyncMappings  ErpSyncMapping[]
  fiscalDocuments  FiscalDocument[]
  orgUsers         OrgUser[]
}

// Mesmos valores de UserRole em apps/pdv-backend/prisma/schema.prisma (enum
// próprio aqui — schemas/bancos diferentes, sem tipo compartilhado possível
// entre SQLite e Postgres — mas os NOMES precisam ficar em sincronia, porque
// o role trafega entre os dois via OrgUserPayload/verify-login, ver
// packages/shared-validation `userRoleSchema`).
enum UserRole {
  operador
  supervisor
  gerente
  administrador
  proprietario
  auditor
  tecnico
}

// Login único entre terminais (2026-08-21) — usuário CANÔNICO por
// organização. Cada terminal (SQLite, User local) continua tendo seu próprio
// espelho/cache, casado por e-mail; este model aqui é a fonte da verdade da
// senha. `@@unique([organizationId, email])` (não email global): duas
// organizações diferentes podem ter administradores com o mesmo e-mail sem
// conflito, cada uma é um cliente EasyPDV independente. `employeeCode`
// sequencial por organização (mesmo padrão do User local, matrícula exibida
// em telas/relatórios, não é mecanismo de login).
model OrgUser {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String
  passwordHash   String
  role           UserRole
  active         Boolean      @default(true)
  employeeCode   Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  document       String?
  timezone       String       @default("America/Sao_Paulo")
  createdAt      DateTime     @default(now())

  activationCodes ActivationCode[]
  terminals       Terminal[]
}

// Provisionamento de terminal (Sprint 10). Um Administrador gera um código
// (via POST /organizations/:id/activation-codes) e informa ao operador do PC
// novo; o Electron troca esse código por uma identidade de Terminal
// permanente em POST /terminals/activate. Curto prazo de validade — não é
// pra ser reutilizado nem persistir além da ativação em si.
model ActivationCode {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Representa um PC/instalação do Electron ativada contra uma Store. apiKeyHash
// é SHA-256 (determinístico, não bcrypt) porque a apiKey já nasce
// alta-entropia/aleatória — o problema aqui é lookup rápido por índice único,
// não resistência a força bruta sobre senha de baixa entropia (esse é o caso
// de uso do bcrypt, usado em User.passwordHash). O valor em texto puro só
// existe uma vez, na resposta de POST /terminals/activate — nunca persistido
// aqui, só localmente no StoreIdentity (SQLite) do PDV local que o recebeu.
model Terminal {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String    @default("Terminal")
  apiKeyHash  String    @unique
  activatedAt DateTime  @default(now())
  lastSeenAt  DateTime?
}

// Só "bling" tem Adapter implementado na V1 — os demais valores existem pra
// bater com packages/shared-types (ErpProvider) e não exigir migration
// quando um segundo ERP for suportado de verdade. Ver docs/ROADMAP.md.
enum ErpProvider {
  bling
  tiny
  omie
  conta_azul
  proprio
}

// Credenciais OAuth por organização (Sprint 7). refresh_token do Bling roda
// a cada uso — accessToken/refreshToken/expiresAt são sempre sobrescritos
// juntos no BlingOAuthClient, nunca atualizados parcialmente.
model ErpIntegration {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       ErpProvider @default(bling)
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  connectedAt    DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([organizationId, provider])
}

// Cache de resolução de IDs externos — evita resolver produto/contato/forma
// de pagamento no Bling a cada sincronização. localEntityType: "product"
// (SKU → id do produto no Bling) | "sale" (Sale.id local → id do pedido de
// venda criado no Bling). Fica fora dos agregados de domínio de propósito —
// é o que impede o Bling de contaminar a arquitetura (ver docs/ARCHITECTURE.md).
model ErpSyncMapping {
  id              String      @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  provider        ErpProvider @default(bling)
  localEntityType String
  localEntityId   String
  externalId      String
  createdAt       DateTime    @default(now())

  @@unique([organizationId, provider, localEntityType, localEntityId])
  @@index([organizationId, provider, localEntityType])
}

// Mesmos enums de packages/shared-types/src/enums.ts (FiscalDocumentType/
// FiscalDocumentStatus) — já pré-desenhados desde o Sprint 0, reaproveitados
// aqui em vez de inventar valores novos. `status` é simplificado a partir da
// `situacao` numérica que o Bling devolve pra NFC-e (1 Pendente, 2 Cancelada,
// 3 Aguardando recibo, 4 Rejeitada, 5 Autorizada, 6 Emitida DANFE,
// 7 Registrada, 8 Aguardando protocolo, 9 Denegada, 10 Consulta situação,
// 11 Bloqueada — ver bling-erp-api-js `ISituacaoNfce`): 1/3/7/8/10→pending,
// 5/6→issued, 2→cancelled, 4/9/11→error (junto com falha da nossa própria
// chamada — rede, Bling fora do ar — que nunca chega a um veredito da SEFAZ).
// `externalStatus` guarda o código bruto do Bling, pra não perder informação.
enum FiscalDocumentType {
  nfce
  comprovante_nao_fiscal
}

enum FiscalDocumentStatus {
  pending
  issued
  cancelled
  error
}

// Rastreia a NFC-e emitida no Bling a partir do pedido de venda já criado
// (ErpSyncMapping localEntityType="sale"). Emissão é opt-in via
// BLING_NFCE_AUTO_EMIT (default desligado) — ver BlingSyncTargetAdapter e
// Claude/Projetos/EasyPDV/Decisões e Riscos Abertos.md no cofre Obsidian:
// emitir NFC-e é uma ação fiscal real (SEFAZ), não reversível como um
// "pedido de venda" de teste, então não roda automaticamente sem a
// organização ter configurado NFC-e de verdade no Bling. O PDV local consulta
// esta tabela sob demanda (GET, ver FiscalController) e espelha o resultado
// simplificado num FiscalDocument próprio (SQLite) — ver docs/DATABASE.md.
model FiscalDocument {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  provider       ErpProvider          @default(bling)
  saleId         String
  type           FiscalDocumentType   @default(nfce)
  status         FiscalDocumentStatus @default(pending)
  externalId     String
  externalStatus Int?
  documentNumber String?
  accessKey      String?
  danfeUrl       String?
  // Sprint 14 — extraído de <infNFeSupl><qrCode> no XML autorizado devolvido
  // pelo Bling (BlingApiClient.findNfce), nunca reconstruído a partir de
  // UF+chave. Ver docs/DATABASE.md.
  qrCodeUrl      String?
  errorMessage   String?
  issuedAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, provider, saleId])
  @@index([saleId])
}

enum SyncStatus {
  pending
  processing
  synced
  failed
}

// Recebido via POST /sync (chamado pelo SyncOutboxWorker do PDV local).
// Enfileirado no BullMQ (fila "sync") para processamento assíncrono.
// `@@unique([entityType, entityId])` garante idempotência: reenvio do mesmo
// entityId (ex: timeout ambíguo do lado do PDV local) não duplica o job.
// Sem Adapter real ainda (ver Sprint 7 — Adapter Bling): o processor desta
// Sprint 6 usa um NoopSyncTargetAdapter só para provar a fila ponta a ponta.
// storeId é opcional porque o provisionamento de terminal (Sprint 10) e a
// autenticação PDV local ↔ Intermediador ainda não existem — ver
// Claude/Projetos/EasyPDV/Decisões e Riscos Abertos.md no cofre Obsidian.
model SyncJob {
  id         String     @id @default(cuid())
  storeId    String?
  entityType String
  entityId   String
  payload    Json
  status     SyncStatus @default(pending)
  attempts   Int        @default(0)
  lastError  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
}
