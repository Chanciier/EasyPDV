// Intermediador — hospedado no Railway, banco PostgreSQL.
// Único lugar que fala com o Bling. Schema inicial do Sprint 0: só o suficiente
// para uma organização/loja se registrar — ver Claude/Projetos/EasyPDV/Modelo de Domínio.md no cofre Obsidian.

// output custom: pdv-backend e intermediador dependem da mesma versão de
// @prisma/client, que o pnpm deduplica para uma única pasta física no store —
// sem isso, `prisma generate` de um app sobrescreve o client gerado do outro
// (schemas diferentes, mesmo destino). Ver docs/BACKEND.md.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  document  String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  stores    Store[]

  erpIntegrations  ErpIntegration[]
  erpSyncMappings  ErpSyncMapping[]
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  document       String?
  timezone       String       @default("America/Sao_Paulo")
  createdAt      DateTime     @default(now())

  activationCodes ActivationCode[]
  terminals       Terminal[]
}

// Provisionamento de terminal (Sprint 10). Um Administrador gera um código
// (via POST /organizations/:id/activation-codes) e informa ao operador do PC
// novo; o Electron troca esse código por uma identidade de Terminal
// permanente em POST /terminals/activate. Curto prazo de validade — não é
// pra ser reutilizado nem persistir além da ativação em si.
model ActivationCode {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Representa um PC/instalação do Electron ativada contra uma Store. apiKeyHash
// é SHA-256 (determinístico, não bcrypt) porque a apiKey já nasce
// alta-entropia/aleatória — o problema aqui é lookup rápido por índice único,
// não resistência a força bruta sobre senha de baixa entropia (esse é o caso
// de uso do bcrypt, usado em User.passwordHash). O valor em texto puro só
// existe uma vez, na resposta de POST /terminals/activate — nunca persistido
// aqui, só localmente no StoreIdentity (SQLite) do PDV local que o recebeu.
model Terminal {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String    @default("Terminal")
  apiKeyHash  String    @unique
  activatedAt DateTime  @default(now())
  lastSeenAt  DateTime?
}

// Só "bling" tem Adapter implementado na V1 — os demais valores existem pra
// bater com packages/shared-types (ErpProvider) e não exigir migration
// quando um segundo ERP for suportado de verdade. Ver docs/ROADMAP.md.
enum ErpProvider {
  bling
  tiny
  omie
  conta_azul
  proprio
}

// Credenciais OAuth por organização (Sprint 7). refresh_token do Bling roda
// a cada uso — accessToken/refreshToken/expiresAt são sempre sobrescritos
// juntos no BlingOAuthClient, nunca atualizados parcialmente.
model ErpIntegration {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  provider       ErpProvider @default(bling)
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  connectedAt    DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([organizationId, provider])
}

// Cache de resolução de IDs externos — evita resolver produto/contato/forma
// de pagamento no Bling a cada sincronização. localEntityType: "product"
// (SKU → id do produto no Bling) | "sale" (Sale.id local → id do pedido de
// venda criado no Bling). Fica fora dos agregados de domínio de propósito —
// é o que impede o Bling de contaminar a arquitetura (ver docs/ARCHITECTURE.md).
model ErpSyncMapping {
  id              String      @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  provider        ErpProvider @default(bling)
  localEntityType String
  localEntityId   String
  externalId      String
  createdAt       DateTime    @default(now())

  @@unique([organizationId, provider, localEntityType, localEntityId])
  @@index([organizationId, provider, localEntityType])
}

enum SyncStatus {
  pending
  processing
  synced
  failed
}

// Recebido via POST /sync (chamado pelo SyncOutboxWorker do PDV local).
// Enfileirado no BullMQ (fila "sync") para processamento assíncrono.
// `@@unique([entityType, entityId])` garante idempotência: reenvio do mesmo
// entityId (ex: timeout ambíguo do lado do PDV local) não duplica o job.
// Sem Adapter real ainda (ver Sprint 7 — Adapter Bling): o processor desta
// Sprint 6 usa um NoopSyncTargetAdapter só para provar a fila ponta a ponta.
// storeId é opcional porque o provisionamento de terminal (Sprint 10) e a
// autenticação PDV local ↔ Intermediador ainda não existem — ver
// Claude/Projetos/EasyPDV/Decisões e Riscos Abertos.md no cofre Obsidian.
model SyncJob {
  id         String     @id @default(cuid())
  storeId    String?
  entityType String
  entityId   String
  payload    Json
  status     SyncStatus @default(pending)
  attempts   Int        @default(0)
  lastError  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([entityType, entityId])
  @@index([status])
}
