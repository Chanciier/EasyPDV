{
  "name": "@easypdv/intermediador",
  "version": "0.0.0",
  "private": true,
  "description": "Serviço hospedado no Railway — único ponto que fala com o Bling. Recebe sincronização de todas as lojas via API, nunca é chamado direto pelo PDV local para completar uma venda.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@easypdv/shared-types": "workspace:*",
    "@easypdv/shared-events": "workspace:*",
    "@easypdv/shared-validation": "workspace:*",
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.2.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.5",
    "nestjs-pino": "^4.2.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@easypdv/eslint-config": "workspace:*",
    "@easypdv/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
