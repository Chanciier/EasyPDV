// Backend local do PDV — banco SQLite, um arquivo por loja.
// Sprint 1 adiciona Identity & Access. Entidades de Catálogo/Estoque/Vendas
// entram nos Sprints 2-5 — ver docs/DATABASE.md e docs/MODULES.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Uma linha só por instalação (um .exe = um terminal = uma loja). apiKey em
// texto puro (não hash) de propósito: precisa ser lida de volta pelo
// HttpSyncGateway pra anexar em cada POST /sync no Intermediador — o hash
// (SHA-256) fica só do lado do Intermediador (Terminal.apiKeyHash), pra
// validar. Mesma fronteira de confiança do arquivo SQLite inteiro: quem tem
// acesso ao disco desta máquina já teria acesso a tudo (vendas, senha hash
// etc.), então não ganha nada mantendo isso num cofre à parte nesta Sprint.
model StoreIdentity {
  id             String   @id @default(cuid())
  organizationId String
  storeId        String
  storeName      String
  terminalId     String
  apiKey         String
  activatedAt    DateTime @default(now())
  // Timestamp do último SyncProductsFromBlingUseCase bem-sucedido (manual,
  // na ativação, ou pelo poll periódico) — usado como `since` do próximo
  // poll incremental de estoque (bling-stock-sync.worker.ts, 2026-08-19).
  // Nullable/sem default: fica null até o primeiro sync completo acontecer;
  // o worker periódico NÃO roda enquanto for null, pra não disparar um sync
  // de catálogo inteiro a cada 5 minutos indefinidamente se o Bling nunca
  // tiver sido conectado (ver SyncProductsFromBlingUseCase e o worker).
  lastBlingSyncAt DateTime?
}

// Papel do usuário. O banco local representa uma única loja (StoreIdentity),
// então diferente do UserStoreRole documentado para o Intermediador (que
// escopa por loja para administradores multi-loja), aqui o papel já é
// implicitamente "nesta loja" — sem precisar de storeId. Ver docs/DATABASE.md.
enum UserRole {
  operador
  supervisor
  gerente
  administrador
  proprietario
  auditor
  tecnico
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Matrícula sequencial (1, 2, 3...) — só identificador exibido em telas/
  // relatórios, não é mecanismo de login. Calculada em código (CreateUserUseCase,
  // max+1) porque SQLite/Prisma não suporta @default(autoincrement()) fora do
  // @id. @unique é rede de segurança contra corrida (dois admins criando
  // usuário ao mesmo tempo), não um lock — mesmo padrão já usado em `email`.
  employeeCode Int      @unique

  authSessions AuthSession[]
  cashSessions CashSession[]
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String
  terminalId       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  parentCategoryId String?
  parentCategory  Category?  @relation("CategoryToCategory", fields: [parentCategoryId], references: [id])
  subcategories   Category[] @relation("CategoryToCategory")
  products        Product[]
  createdAt       DateTime   @default(now())
}

model Product {
  id         String     @id @default(cuid())
  sku        String     @unique
  name       String
  categoryId String?
  category   Category?  @relation(fields: [categoryId], references: [id])
  unit       String     @default("un")
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  // Timestamp da última vez que este produto foi criado/atualizado por um
  // sync do Bling (qualquer um dos dois: completo ou incremental) — null
  // pra produto criado só localmente (botão "+ Novo produto"), nunca visto
  // no Bling. Usado por SyncProductsFromBlingUseCase pra decidir quais
  // produtos DESATIVAR quando um sync completo não traz mais um SKU que
  // antes existia (produto apagado/inativado no Bling) — só produtos com
  // blingSyncedAt preenchido entram nessa varredura, pra nunca desativar
  // por engano algo cadastrado só no PDV (2026-08-19).
  blingSyncedAt DateTime?

  barcodes       Barcode[]
  priceListItems PriceListItem[]

  @@index([categoryId])
}

// Um produto pode ter mais de um código (unidade, caixa, fornecedor) — ver docs/DATABASE.md.
model Barcode {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  code      String   @unique
  type      String   @default("ean13")
  createdAt DateTime @default(now())

  @@index([productId])
}

// V1 usa uma única PriceList "padrão" (active=true); múltiplas tabelas em
// uso real (por canal/segmento) são V2 — ver docs/ROADMAP.md.
model PriceList {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items PriceListItem[]
}

// Preço nunca é campo direto no Product — sempre resolvido via PriceListItem
// vigente. Ver docs/CODING-STANDARDS.md / princípios de arquitetura.
model PriceListItem {
  id                String    @id @default(cuid())
  priceListId       String
  priceList         PriceList @relation(fields: [priceListId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  price             Float
  promotionalPrice  Float?
  validFrom         DateTime?
  validTo           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

// V1 tem 1 depósito por loja; a estrutura já suporta N — ver docs/ROADMAP.md.
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  stockItems     StockItem[]
  stockMovements StockMovement[]
}

// Saldo materializado — projeção de StockMovement, nunca a fonte da verdade.
model StockItem {
  id               String    @id @default(cuid())
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  productId        String
  quantity         Float     @default(0)
  reservedQuantity Float     @default(0)
  updatedAt        DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

enum StockMovementType {
  entrada
  saida
  ajuste
  venda
  devolucao
}

// Ledger append-only — é a fonte da verdade real do estoque. `quantity` é
// sempre o delta assinado já aplicado ao StockItem (positivo = aumentou o
// saldo, negativo = diminuiu) — `type` só documenta o motivo, não o sinal.
model StockMovement {
  id            String            @id @default(cuid())
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  productId     String
  type          StockMovementType
  quantity      Float
  referenceType String?
  referenceId   String?
  createdByUserId String?
  createdAt     DateTime          @default(now())

  @@index([warehouseId, productId])
}

model CashRegister {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sessions CashSession[]
}

enum CashSessionStatus {
  open
  closed
  reconciled
}

// Sessão é o vínculo temporário operador↔caixa — o caixa em si é um recurso
// independente, reutilizado por operadores diferentes em turnos diferentes.
// Ver docs/DATABASE.md.
model CashSession {
  id             String            @id @default(cuid())
  cashRegisterId String
  cashRegister   CashRegister      @relation(fields: [cashRegisterId], references: [id])
  operatorUserId String
  operator       User              @relation(fields: [operatorUserId], references: [id])
  terminalId     String?
  openingAmount  Float
  closingAmount  Float?
  expectedAmount Float?
  status         CashSessionStatus @default(open)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?

  movements CashMovement[]
  sales     Sale[]

  @@index([cashRegisterId])
  @@index([operatorUserId])
}

enum CashMovementType {
  sangria
  suprimento
  ajuste
}

model CashMovement {
  id                 String           @id @default(cuid())
  cashSessionId      String
  cashSession        CashSession      @relation(fields: [cashSessionId], references: [id])
  type               CashMovementType
  amount             Float
  reason             String?
  authorizedByUserId String?
  createdAt          DateTime         @default(now())

  @@index([cashSessionId])
}

enum SaleStatus {
  draft
  pending
  confirmed
  cancelled
}

// Cliente da venda — antes da Sprint 15 era só um mock no frontend, sem
// nenhuma linha de verdade. onDelete: SetNull em Sale.customer: excluir um
// cliente não pode apagar/travar o histórico de vendas dele — a venda só
// volta a mostrar "Consumidor Final" (customerId null), mesma convenção já
// usada pra venda sem cliente vinculado.
model Customer {
  id        String   @id @default(cuid())
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([name])
}

// Sprint 4: só draft/cancelled (sem pagamento ainda). confirmed + débito de
// estoque + auditoria entram juntos na Sprint 5, numa única transação
// atômica — ver docs/DATABASE.md "evento central".
model Sale {
  id             String      @id @default(cuid())
  cashSessionId  String
  cashSession    CashSession @relation(fields: [cashSessionId], references: [id])
  operatorUserId String
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         SaleStatus  @default(draft)
  totalAmount    Float       @default(0)
  discountAmount Float       @default(0)
  createdAt      DateTime    @default(now())
  confirmedAt    DateTime?

  items          SaleItem[]
  payments       Payment[]
  fiscalDocument FiscalDocument?

  @@index([cashSessionId])
}

model SaleItem {
  id             String @id @default(cuid())
  saleId         String
  sale           Sale   @relation(fields: [saleId], references: [id])
  productId      String
  quantity       Float
  unitPrice      Float
  discountAmount Float  @default(0)
  totalAmount    Float

  @@index([saleId])
}

enum PaymentMethod {
  dinheiro
  cartao
  pix
  outro
}

enum PaymentCardType {
  credito
  debito
}

enum PaymentStatus {
  aprovado
  pendente
  recusado
}

// V1 sem TEF/gateway real — pagamento em cartão é declarado manualmente pelo
// operador (a maquininha física já aprovou) e entra direto como "aprovado".
// Ver docs/ROADMAP.md "por que fica fora da V1". cardType/installments só
// fazem sentido quando method="cartao" — não reforçado no schema (SQLite não
// tem CHECK condicional prático via Prisma), validado no Zod (shared-validation).
model Payment {
  id                String           @id @default(cuid())
  saleId            String
  sale              Sale             @relation(fields: [saleId], references: [id])
  method            PaymentMethod
  amount            Float
  cardType          PaymentCardType?
  installments      Int?
  status            PaymentStatus    @default(aprovado)
  authorizationCode String?
  createdAt         DateTime         @default(now())

  @@index([saleId])
}

enum SyncStatus {
  pending
  processing
  synced
  failed
}

// Transactional outbox: gravado na mesma transação que SaleConfirmed (ver
// PrismaSaleRepository.confirm()) — se a venda foi commitada, a entrada de
// sync também foi, sem exceção. `SyncOutboxWorker` varre por status=pending
// e faz POST /sync no Intermediador; "synced" aqui só significa "entregue
// à fila do Intermediador", não que o Bling já processou. Ver docs/DATABASE.md.
model SyncOutbox {
  id         String     @id @default(cuid())
  entityType String
  entityId   String
  payload    String
  status     SyncStatus @default(pending)
  attempts   Int        @default(0)
  lastError  String?
  createdAt  DateTime   @default(now())
  sentAt     DateTime?

  @@index([status])
}

enum FiscalDocumentType {
  nfce
  comprovante_nao_fiscal
}

enum FiscalDocumentStatus {
  pending
  issued
  cancelled
  error
}

// Espelho local do FiscalDocument do Intermediador (Sprint 12) — consultado
// sob demanda via GET no Intermediador (o PDV local nunca fala com o Bling
// direto) e persistido aqui pra ficar visível no Histórico mesmo offline,
// sem precisar de rede toda vez. Sync é unidirecional Intermediador→local
// só pra este campo (diferente do SyncOutbox, que é local→Intermediador);
// não existe push automático, é o próprio pdv-backend que pergunta.
model FiscalDocument {
  id             String               @id @default(cuid())
  saleId         String               @unique
  sale           Sale                 @relation(fields: [saleId], references: [id])
  type           FiscalDocumentType   @default(nfce)
  status         FiscalDocumentStatus @default(pending)
  documentNumber String?
  accessKey      String?
  danfeUrl       String?
  // Sprint 14 — espelhado do FiscalDocument do Intermediador, extraído lá do
  // XML autorizado (<infNFeSupl><qrCode>), nunca reconstruído aqui.
  qrCodeUrl      String?
  errorMessage   String?
  issuedAt       DateTime?
  updatedAt      DateTime             @updatedAt
}

// Trilha imutável (Sprint 13) — sem update/delete no domínio, só create.
// userId opcional (nunca nulo na prática hoje, todo endpoint auditado exige
// auth, mas mantido nullable pra não travar um evento futuro sem ator
// humano). metadata é JSON serializado (mesmo padrão de SyncOutbox.payload).
// sale.confirmed é escrito na MESMA transação de PrismaSaleRepository.confirm()
// (o evento central do sistema, ver Modelo de Domínio no cofre Obsidian); os
// demais são escritos logo após a ação principal ter sucesso, sem a mesma
// garantia de atomicidade — simplificação V1 deliberada, auditoria não é a
// fonte da verdade do dado em si.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
