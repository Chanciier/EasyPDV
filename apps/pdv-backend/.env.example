DATABASE_URL="file:./dev.db"
PORT=4001
NODE_ENV=development

# Trocar por um segredo forte em produção — nunca versionar o valor real.
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# Usado só pelo prisma/seed.ts para criar o primeiro Administrador em dev local.
SEED_ADMIN_EMAIL="admin@easypdv.local"
SEED_ADMIN_PASSWORD="troque-esta-senha"
