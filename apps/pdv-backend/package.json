{
  "name": "@easypdv/pdv-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Backend local do PDV — roda dentro do .exe instalado no PC da loja. Banco SQLite. Nunca depende de internet para concluir uma venda.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests yet\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@easypdv/shared-types": "workspace:*",
    "@easypdv/shared-events": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "nestjs-pino": "^4.2.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@easypdv/eslint-config": "workspace:*",
    "@easypdv/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3"
  }
}
